# Copie para .env e preencha as credenciais do seu banco.
# Use dev para PostgreSQL local no Docker, test para H2 ou prod para producao.
APP_PROFILE=prod
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/futcompetitivo
DB_USERNAME=postgres
DB_PASSWORD=

# Profile dev: independente das credenciais DB_* de producao.
DEV_DB_PORT=5433
DEV_DB_USERNAME=futcompetitivo
DEV_DB_PASSWORD=futcompetitivo_dev

# Autenticacao: obrigatorios em producao.
CLIENT_ID=futcompetitivo
CLIENT_SECRET=
JWT_ISSUER=https://sua-api.example.com
JWT_DURATION=3600
JWT_JWK=
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
